#!/usr/bin/env bash
#
# uninstall — remove Sepian from the current user.
#
# Removes:
#   1. The local .venv (Python dependencies)
#   2. ~/.local/share/applications/sepian.desktop (launcher)
#   3. Refreshes the desktop database
#
# Does NOT touch:
#   - System packages (python3-tk, adb, etc.)
#   - Whisper models cached under ~/.cache/whisper
#   - Your source files (sepianai.py, plugins/, etc.)
#
# Usage:
#   ./uninstall
#

set -euo pipefail

WORKDIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$WORKDIR/.venv"
DESKTOP_FILE="$HOME/.local/share/applications/sepian.desktop"

say()  { printf '\033[1;36m[sepian]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[sepian]\033[0m %s\n' "$*" >&2; }

# --- venv ---------------------------------------------------------------------
if [ -d "$VENV_DIR" ]; then
    say "Removing virtualenv at $VENV_DIR ..."
    rm -rf "$VENV_DIR"
    say "Virtualenv removed."
else
    say "No virtualenv at $VENV_DIR — skipping."
fi

# --- desktop launcher ---------------------------------------------------------
if [ -f "$DESKTOP_FILE" ]; then
    say "Removing launcher at $DESKTOP_FILE ..."
    rm -f "$DESKTOP_FILE"
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
    fi
    say "Launcher removed."
else
    say "No launcher at $DESKTOP_FILE — skipping."
fi

# --- whisper cache (optional) -------------------------------------------------
WHISPER_CACHE="$HOME/.cache/whisper"
if [ -d "$WHISPER_CACHE" ]; then
    SIZE=$(du -sh "$WHISPER_CACHE" 2>/dev/null | cut -f1)
    warn "Found Whisper model cache at $WHISPER_CACHE ($SIZE)."
    warn "This is left in place. To free disk space, run:"
    warn "    rm -rf $WHISPER_CACHE"
fi

cat <<'DONE'

✔ Sepian is uninstalled.

To re-install later, from this directory:
    ./install

DONE
