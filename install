#!/usr/bin/env bash
#
# install — set up Sepian for the current user.
#
# What it does:
#   1. Verifies Python 3.10+ is available.
#   2. Installs Linux system packages (python3-tk, adb, portaudio, libasound2-dev).
#      Prompts before invoking sudo; skips anything already installed.
#   3. Creates a local .venv in the workspace.
#   4. Installs Python dependencies from requirements.txt into the venv.
#   5. Renders sepian.desktop.template with the correct paths and installs it
#      to ~/.local/share/applications/sepian.desktop.
#   6. Refreshes the desktop database so the launcher appears immediately.
#
# Re-running this script is safe: it is idempotent.
#
# Usage:
#   ./install             # normal install
#   ./install --no-sys    # skip apt install (system deps already present)
#

set -euo pipefail

# --- Paths --------------------------------------------------------------------
WORKDIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$WORKDIR/.venv"
TEMPLATE="$WORKDIR/sepian.desktop.template"
APPS_DIR="$HOME/.local/share/applications"
DESKTOP_FILE="$APPS_DIR/sepian.desktop"

# --- Options ------------------------------------------------------------------
INSTALL_SYS_DEPS=1
for arg in "$@"; do
    case "$arg" in
        --no-sys) INSTALL_SYS_DEPS=0 ;;
        -h|--help)
            sed -n '2,20p' "$0"
            exit 0
            ;;
        *) echo "Unknown option: $arg" >&2; exit 2 ;;
    esac
done

# --- Pretty output ------------------------------------------------------------
say()  { printf '\033[1;36m[sepian]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[sepian]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[sepian]\033[0m %s\n' "$*" >&2; exit 1; }

# --- Step 1: Python ------------------------------------------------------------
say "Checking Python..."
if ! command -v python3 >/dev/null 2>&1; then
    die "python3 not found. Install Python 3.10+ and re-run."
fi
PY_MINOR=$(python3 -c 'import sys; print(sys.version_info.minor)')
PY_MAJOR=$(python3 -c 'import sys; print(sys.version_info.major)')
say "Found python3 $PY_MAJOR.$PY_MINOR"
if [ "$PY_MAJOR" -lt 3 ] || { [ "$PY_MAJOR" -eq 3 ] && [ "$PY_MINOR" -lt 10 ]; }; then
    die "Sepian requires Python 3.10 or newer."
fi

# --- Step 2: Linux system deps (optional) --------------------------------------
if [ "$INSTALL_SYS_DEPS" -eq 1 ]; then
    if command -v apt-get >/dev/null 2>&1; then
        say "Detected apt — checking system packages..."
        # build-essential + python3-dev ensure PyAudio can compile from source
        # on minimal installs where the prebuilt wheel is unavailable.
        NEEDED_PKGS=(python3-tk python3-dev build-essential adb portaudio19-dev libasound2-dev libbluetooth-dev)
        MISSING=()
        for pkg in "${NEEDED_PKGS[@]}"; do
            if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed"; then
                MISSING+=("$pkg")
            fi
        done
        if [ ${#MISSING[@]} -gt 0 ]; then
            say "Missing packages: ${MISSING[*]}"
            if [ "$(id -u)" -ne 0 ]; then
                if command -v sudo >/dev/null 2>&1; then
                    say "Requesting sudo to install system packages..."
                    sudo -v || die "sudo failed; rerun with --no-sys if deps are already installed."
                else
                    die "Need root to install system packages. Rerun with --no-sys if deps are present."
                fi
                sudo apt-get update
                sudo apt-get install -y "${MISSING[@]}"
            else
                apt-get update
                apt-get install -y "${MISSING[@]}"
            fi
        else
            say "All system packages already installed."
        fi
    elif command -v dnf >/dev/null 2>&1; then
        warn "Fedora/RHEL detected. Install python3-tkinter, alsa-lib-devel, portaudio-devel, adb, bluez-libs-devel manually if needed."
    elif command -v pacman >/dev/null 2>&1; then
        warn "Arch detected. Install tk, alsa-lib, portaudio, android-tools, bluez-libs manually if needed."
    else
        warn "Unknown package manager. Ensure python3-tk, portaudio, libasound2, adb are installed."
    fi
else
    say "Skipping system package install (--no-sys)."
fi

# --- Step 3: venv --------------------------------------------------------------
say "Setting up virtualenv at $VENV_DIR ..."
if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
    say "Created venv."
else
    say "Reusing existing venv."
fi
# shellcheck disable=SC1091
source "$VENV_DIR/bin/activate"
PYTHON_BIN="$VENV_DIR/bin/python"
python -m pip install --upgrade pip wheel >/dev/null

# --- Step 4: Python deps ------------------------------------------------------
# Two-stage install: the CPU PyTorch wheel lives on download.pytorch.org
# and is referenced via the "+cpu" local version tag in requirements.txt.
# A plain `pip install -r` will resolve torch from the default PyPI index
# (CUDA build), so we install torch+torchaudio from the CPU index FIRST,
# then install the rest of requirements.txt on top.
say "Installing PyTorch (CPU build) from pytorch.org ..."
pip install --upgrade \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    "torch==2.7.1+cpu" "torchaudio==2.7.1+cpu"
say "Installing remaining Python dependencies from requirements.txt ..."
# Re-pin so pip picks up the CPU wheel when it sees "torch==2.7.1+cpu"
# in requirements.txt; otherwise the default CUDA build wins.
pip install \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r "$WORKDIR/requirements.txt"
say "Python dependencies installed."

# --- Step 4.5: Verify imports --------------------------------------------------
# Catch partial installs (e.g. PyAudio wheel build failed silently) BEFORE
# the user discovers them at runtime. We treat each module as optional with
# an "impact" string so the user knows what's actually broken.
say "Verifying critical Python imports ..."
VERIFY_FAIL=0
verify_import() {
    local mod="$1"
    local label="$2"
    local impact="$3"
    if "$PYTHON_BIN" -c "import $mod" >/dev/null 2>&1; then
        printf '  \033[1;32m✓\033[0m  %-18s  ok\n' "$label"
    else
        printf '  \033[1;31m✗\033[0m  %-18s  MISSING — %s\n' "$label" "$impact"
        VERIFY_FAIL=1
    fi
}
verify_import "tkinter"   "tkinter"      "GUI will not start"
verify_import "PIL"       "Pillow"       "avatar/head will not render"
verify_import "requests"  "requests"     "no LLM/HTTP calls"
verify_import "pygame"    "pygame"       "no TTS audio playback"
verify_import "edge_tts"  "edge-tts"     "no text-to-speech"
verify_import "pyaudio"   "PyAudio"      "microphone input disabled"
verify_import "speech_recognition" "SpeechRecognition" "voice input disabled"
verify_import "zeroconf"  "zeroconf"     "smart-home discovery disabled"

# Optional modules: commented out in requirements.txt by default. A missing
# optional module is informational only — it should NOT set VERIFY_FAIL.
warn_optional() {
    local mod="$1"
    local label="$2"
    local impact="$3"
    if "$PYTHON_BIN" -c "import $mod" >/dev/null 2>&1; then
        printf '  \033[1;32m✓\033[0m  %-18s  ok (optional)\n' "$label"
    else
        printf '  \033[1;33m·\033[0m  %-18s  not installed (optional — %s)\n' "$label" "$impact"
    fi
}
warn_optional "whisper"  "openai-whisper" "offline STT disabled"
warn_optional "bleak"    "bleak"         "BLE smart-bulb control disabled"
warn_optional "cv2"      "opencv-python" "person detection disabled"

if [ "$VERIFY_FAIL" -ne 0 ]; then
    warn "Some features are broken. See ✗ entries above."
    warn "Re-run ./install, or run: $VENV_DIR/bin/pip install -r requirements.txt"
else
    say "All critical imports verified."
fi

# --- Step 5: Render .desktop file ---------------------------------------------
if [ ! -f "$TEMPLATE" ]; then
    die "Template not found: $TEMPLATE"
fi
say "Installing launcher to $DESKTOP_FILE ..."
mkdir -p "$APPS_DIR"
# PYTHON_BIN was set during verification; redeclare for clarity.
PYTHON_BIN="$VENV_DIR/bin/python"
# Substitute placeholders. Use a delimiter that won't collide with paths.
sed -e "s|@@WORKDIR@@|$WORKDIR|g" \
    -e "s|@@VENV@@|$VENV_DIR|g" \
    "$TEMPLATE" > "$DESKTOP_FILE"
chmod 644 "$DESKTOP_FILE"
say "Launcher installed."

# --- Step 6: Refresh desktop database ----------------------------------------
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$APPS_DIR" 2>/dev/null || true
    say "Desktop database refreshed."
else
    warn "update-desktop-database not found; launcher should still appear on next login."
fi

if [ "$VERIFY_FAIL" -ne 0 ]; then
    cat <<'DONE'

✔ Sepian is installed — but some features are broken.

  Review the ✗ entries above to see what's missing.
  Re-run  ./install  after fixing the listed system packages,
  or:  .venv/bin/pip install -r requirements.txt

Launch from your application menu (look for "Sepian"),
or run from a terminal:

    ./.venv/bin/python sepianai.py

To re-run this installer later, just:  ./install
DONE
else
    cat <<'DONE'

✔ Sepian is installed.

Launch from your application menu (look for "Sepian"),
or run from a terminal:

    ./.venv/bin/python sepianai.py

To re-run this installer later, just:  ./install
DONE
fi
